# Copy to .env.local and fill in. See README "Go live" checklist.

# Supabase (Project Settings → API)
# Also required, dashboard-only (no env var for this): Authentication → Providers
# — turn ON "Allow anonymous sign-ins", turn OFF "Confirm email". Every player's
# identity runs on anonymous auth; without this, /new and /api/join both fail.
# That rate-limits to 30 sign-ins/hour/IP by default — raise it before party night,
# see README "Setup".
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # server-only, never NEXT_PUBLIC

# Anthropic (director + story generation)
ANTHROPIC_API_KEY=sk-ant-...

# Model tiering
DIRECTOR_MODEL=claude-sonnet-5          # beat planning, event reactions
FAST_MODEL=claude-haiku-4-5-20251001    # heartbeats, flavor, entrance garnish
STORY_MODEL=claude-sonnet-5             # story generation (quality matters most)

# Shared secret so only trusted callers (pg_cron, TV display) can tick the director
DIRECTOR_TICK_SECRET=change-me

# Base URL of the deployed app (QR codes, links)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
